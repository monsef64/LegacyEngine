body {
    font-family: Roboto;
    font-size: 18dp;
    color: #edf4ff;
    width: 100%;
    height: 100%;
    margin: 0;
    pointer-events: none;
}
#hud {
    position: absolute;
    top: 4%;
    left: 4%;
    width: 440dp;
    max-width: 86%;
    padding: 24dp;
    background-color: #101b2bed;
    border: 1dp #3c5473;
    border-radius: 12dp;
    pointer-events: auto;
}
.eyebrow { font-size: 12dp; color: #6ce5c7; letter-spacing: 2dp; }
h1 { font-size: 30dp; margin: 12dp 0; }
p { margin: 10dp 0; }
.stat { padding: 10dp 0; border-bottom: 1dp #324055; }
.stat span { float: right; color: #6ce5c7; }
.buttons { margin-top: 18dp; }
button {
    display: inline-block;
    padding: 10dp 12dp;
    margin: 0 6dp 6dp 0;
    background-color: #266659;
    color: #ffffff;
    border: 1dp #45b69c;
    border-radius: 5dp;
    cursor: pointer;
}
button:hover { background-color: #318873; }
button:active { background-color: #19473e; }
button:focus { border-color: #ffffff; }
#status { min-height: 44dp; color: #b6ccdf; }
.hint { font-size: 13dp; color: #92a9bf; }
input { background-color: #09121e; color: #edf4ff; padding: 8dp; border: 1dp #3c5473; width: 90%; }
input:focus { border-color: #6ce5c7; }
#badge { position: absolute; right: 4%; bottom: 4%; color: #6ce5c7; font-size: 13dp; }
