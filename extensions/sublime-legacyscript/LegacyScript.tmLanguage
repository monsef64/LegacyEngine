<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>lua</string>
		<string>ls</string>
	</array>
	<key>name</key>
	<string>LegacyScript</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>^\s*(?:global|expose)\b</string>
			<key>name</key>
			<string>keyword.other.export.legacyscript</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>--\[(=*)\[</string>
			<key>end</key>
			<string>\]\1\]</string>
			<key>name</key>
			<string>comment.block.lua</string>
		</dict>
		<dict>
			<key>match</key>
			<string>--.*$</string>
			<key>name</key>
			<string>comment.line.double-dash.lua</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>name</key>
			<string>string.quoted.double.lua</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\\.</string>
					<key>name</key>
					<string>constant.character.escape.lua</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>begin</key>
			<string>'</string>
			<key>end</key>
			<string>'</string>
			<key>name</key>
			<string>string.quoted.single.lua</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\\.</string>
					<key>name</key>
					<string>constant.character.escape.lua</string>
				</dict>
			</array>
		</dict>
		<dict>
			<key>begin</key>
			<string>\[(=*)\[</string>
			<key>end</key>
			<string>\]\1\]</string>
			<key>name</key>
			<string>string.unquoted.lua</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(and|break|do|else|elseif|end|for|function|goto|if|in|local|not|or|repeat|return|then|until|while)\b</string>
			<key>name</key>
			<string>keyword.control.lua</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(true|false|nil)\b</string>
			<key>name</key>
			<string>constant.language.lua</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\bself\b</string>
			<key>name</key>
			<string>variable.language.lua</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(GameObject|Camera|Transform|RigidBody|Collider|MeshRenderer|LuaScript|ParticleSystem)\b</string>
			<key>name</key>
			<string>support.class.legacyscript</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[0-9]+(\.[0-9]+)?\b</string>
			<key>name</key>
			<string>constant.numeric.lua</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.legacyscript</string>
</dict>
</plist>
