{
  "name": "legacyscript",
  "displayName": "LegacyScript",
  "description": "LegacyEngine .ls language support with an LSP server, completion and API help.",
  "version": "0.1.0",
  "publisher": "legacyengine",
  "license": "GPL-2.0-only",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "repository": { "type": "git", "url": "https://github.com/monsef64/LegacyEngine.git", "directory": "extensions/legacyscript" },
  "activationEvents": ["onLanguage:legacyscript"],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [{ "id": "legacyscript", "aliases": ["LegacyScript", "ls"], "extensions": [".ls"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "legacyscript", "scopeName": "source.legacyscript", "path": "./syntaxes/legacyscript.tmLanguage.json" }],
    "snippets": [{ "language": "legacyscript", "path": "./snippets/legacyscript.json" }]
  },
  "scripts": {
    "generate": "node scripts/generate-api.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package --out legacyscript.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": { "@vscode/vsce": "^3.2.2" }
}
