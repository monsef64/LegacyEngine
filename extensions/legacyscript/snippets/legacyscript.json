{
  "Start": {
    "prefix": "onStart",
    "body": [
      "function onStart()",
      "    $0",
      "end"
    ]
  },
  "Update": {
    "prefix": "onUpdate",
    "body": [
      "function onUpdate(deltaTime)",
      "    $0",
      "end"
    ]
  },
  "Fixed update": {
    "prefix": "onFixedUpdate",
    "body": [
      "function onFixedUpdate(deltaTime)",
      "    $0",
      "end"
    ]
  },
  "Destroy": {
    "prefix": "onDestroy",
    "body": [
      "function onDestroy()",
      "    $0",
      "end"
    ]
  },
  "Camera FOV": {
    "prefix": "cameraFov",
    "body": [
      "function onStart()",
      "    self:setFieldOfView(${1:90})",
      "end"
    ],
    "description": "Set FOV on owning Camera"
  },
  "Export field": {
    "prefix": "export",
    "body": [
      "@export ${1:target} ${2|GameObject,ParticleSystem,AudioSource,AudioListener,Transform,RigidBody,Collider,Camera,Skybox,Texture,AudioClip,Asset,number,boolean,string|} ${3}"
    ],
    "description": "Declare an Inspector-assigned LegacyScript field"
  },
  "Independent waiting task": {
    "prefix": "task",
    "body": [
      "task(function()",
      "    waitForSeconds(${1:1})",
      "    $0",
      "end)"
    ],
    "description": "Independent cooperative block: waits pause only this task, not its caller"
  },
  "Draw runtime GUI": {
    "prefix": "onGUI",
    "body": [
      "function onGUI()",
      "    if GUI.beginWindow(\"${1:HUD}\") then",
      "        GUI.text(\"${2:Hello}\")",
      "        $0",
      "    end",
      "    GUI.endWindow()",
      "end"
    ],
    "description": "Draw runtime ImGui once per rendered Game frame; no onStart registration."
  }
}
