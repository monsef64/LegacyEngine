execute_process(COMMAND "${PROBE}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Logging probe failed: ${result}: ${err}")
endif()
foreach(marker "[LegacyEngine] [INFO]" "[WARNING]" "[ERROR]" "test startup" "test clean shutdown" "missing again")
  string(FIND "${err}" "${marker}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Missing terminal log: ${marker}: ${err}")
  endif()
endforeach()
string(REGEX MATCHALL "missing texture" repeats "${err}")
list(LENGTH repeats count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Repeated error state should print once: ${err}")
endif()
execute_process(COMMAND "${PROBE}" terminate RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(result STREQUAL "0" OR NOT err MATCHES "test unhandled exception" OR NOT err MATCHES "FATAL")
  message(FATAL_ERROR "Unhandled exception was not reported: ${result}: ${err}")
endif()
if(NOT WIN32)
  execute_process(COMMAND "${PROBE}" crash RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(result STREQUAL "0" OR result STREQUAL "3" OR NOT err MATCHES "SIGSEGV")
    message(FATAL_ERROR "Fatal signal was not reported: ${result}: ${err}")
  endif()
endif()
